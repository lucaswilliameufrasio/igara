# Igará configuration
# Copy this file to .env and adjust as needed.

# Override the config directory (default: ~/.config/igara)
# IGARA_CONFIG_DIR=/tmp/igara-dev

# Log level (default: info)
# RUST_LOG=debug

# Skip SSH key generation (useful for testing without ssh-keygen)
# IGARA_SKIP_SSH_KEYGEN=1

# GitHub repo for install script (default: lucaswilliameufrasio/igara)
# IGARA_REPO=lucaswilliameufrasio/igara

# Install directory (default: ~/.local/bin)
# IGARA_INSTALL_DIR=~/bin

# Version to install (default: latest)
# IGARA_VERSION=v0.1.0
